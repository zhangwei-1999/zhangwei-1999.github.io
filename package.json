{
  "name": "wei-zhang-academic-homepage",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node --import tsx scripts/prerender.tsx",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:static": "playwright test --config playwright.static.config.ts",
    "check:build": "node --import tsx scripts/check-build.ts",
    "optimize:image": "node scripts/optimize-image.mjs",
    "gallery:encrypt": "node --import tsx scripts/encrypt-gallery.ts",
    "gallery:admin:prepare": "node --import tsx scripts/gallery-admin-prepare.ts",
    "gallery:managed": "node --import tsx scripts/gallery-managed.ts",
    "gallery:service:dev": "wrangler dev --config services/gallery-worker/wrangler.jsonc --port 8787 --var ENVIRONMENT:local --var ALLOWED_ORIGINS:http://127.0.0.1:5173,http://127.0.0.1:4173,http://127.0.0.1:4180",
    "gallery:service:deploy": "wrangler deploy --config services/gallery-worker/wrangler.jsonc",
    "gallery:service:migrate": "wrangler d1 migrations apply DB --local --config services/gallery-worker/wrangler.jsonc"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "sharp": "0.35.5",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.0",
    "wrangler": "4.150.0"
  }
}
