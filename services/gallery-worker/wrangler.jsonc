{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "wei-gallery-audit",
  "account_id": "c19fb2310eec8bd10677736331112046",
  "main": "entry.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://zhangwei-1999.github.io",
